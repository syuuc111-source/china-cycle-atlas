  "element_order": [
    "a_AU",
    "e",
    "I_deg",
    "L_deg",
    "longitude_perihelion_deg",
    "longitude_node_deg"
  ],
  "rate_units": "每儒略世纪；a为AU/世纪、e为1/世纪、角为度/世纪",
  "extra_order": [
    "b",
    "c",
    "s",
    "f"
  ],
  "time_formula": "T=(JDTDB-2451545.0)/36525",
  "M_formula": "M=L-peri+b*T*T+c*cos(f*T)+s*sin(f*T); f*T为度",
  "validity": {
    "start_astro_year": -2999,
    "end_astro_year": 3000,
    "text": "JPL标前3000–公元3000；历史无0年，应转天文年。用户界面若直接用年，应定义该年的具体取样日期。"
  },
  "limitations": [
    "模型参数为区间最佳拟合，不是精密实测轨道常数，不能外推有效期外。",
    "元素L称均黄经，但L本身不是解Kepler后实际近似日心黄经。",
    "应先归一化M，再解E-e*sin(E)=M；三角计算用弧度，一致转换。",
    "给定JD理想为TDB；使用公历日期UTC近似需说明未作TT/TDB及古代DeltaT转换，不能声称秒级精度。",
    "固定J2000黄道/春分点坐标，不是日期真黄道或中国某地点的地平坐标。",
    "日心图不能直接用来判断地心合相、冲、逆行或月亮入宿。",
    "不要把每天绕一宿或28日循环当作真实月亮运行。"
  ],
  "period_model": {
    "synodic_formula": "S=1/abs(1/P-1/E)",
    "units": "P、E、S用同一时间单位",
    "meaning": "同向近圆轨道的平均会合周期近似，不是每次合相间隔的精密预报",
    "earth_period_days": 365.256
  },
